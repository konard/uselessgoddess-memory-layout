/* Общий стиль приложения */
QMainWindow, QWidget {
  background: #f2f2f2;
}

QPushButton {
  background-color: #e6e6e6;
  border: 1px solid #c9c9c9;
  padding: 6px 10px;
  border-radius: 4px;
}
QPushButton:hover {
  background-color: #eeeeee;
}
QPushButton:pressed {
  background-color: #dddddd;
}

QLabel {
  color: #333;
}

QPlainTextEdit {
  background: #ffffff;
  border: 1px solid #cfcfcf;
}

QComboBox, QLineEdit {
  background: #ffffff;
  border: 1px solid #cfcfcf;
  border-radius: 3px;
  padding: 4px;
}

QTreeView {
  background: #ffffff;
  alternate-background-color: #fafafa;
  border: 1px solid #cfcfcf;
}
QHeaderView::section {
  background: #ececec;
  border: 1px solid #d8d8d8;
  padding: 4px;
}

